<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ch:R14 直接链接生产源码：CRC 回归测的是 WindowsFormsApplication1 正在跑的那份实现，
         而不是测试里的复刻副本（复刻版会与生产悄悄分叉，测试形同虚设） -->
    <Compile Include="..\WindowsFormsApplication1\Core\ModbusCrc.cs" Link="Core\ModbusCrc.cs" />
    <!-- ch:R42 同上：TCP 触发串组帧器直链生产源码 -->
    <Compile Include="..\WindowsFormsApplication1\Core\ProtoFrameAssembler.cs" Link="Core\ProtoFrameAssembler.cs" />
    <!-- ch:R12 同上：方案切换载图串匹配器直链生产源码 -->
    <Compile Include="..\WindowsFormsApplication1\Core\SchemeMatcher.cs" Link="Core\SchemeMatcher.cs" />
    <!-- ch:R12 方案表数据层同为纯托管，直链测同一份实现 -->
    <Compile Include="..\WindowsFormsApplication1\Core\SchemeStore.cs" Link="Core\SchemeStore.cs" />
    <!-- ch:R44 相机10方案切换防呆：通道变化去重 + 多通道配置冲突检查 -->
    <Compile Include="..\WindowsFormsApplication1\Core\Cam10ChangeTracker.cs" Link="Core\Cam10ChangeTracker.cs" />
    <Compile Include="..\WindowsFormsApplication1\Core\SchemeSwitchConfig.cs" Link="Core\SchemeSwitchConfig.cs" />
    <!-- ch:R45 方案表段解析：Form3 独立段 + 旧段回退 -->
    <Compile Include="..\WindowsFormsApplication1\Core\SerialSchemeSection.cs" Link="Core\SerialSchemeSection.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
